/// \file
/// \brief Generated translation unit of the pure-LUpp benchmark:
/// registers the variant grid of dimension @TDLS_BENCH_DIM@.
/// \author Tristan Chenaille
/// \copyright Copyright (C) 2026 CEA. All rights reserved.
/// This project is publicly released under the BSD 3-Clause License
/// (see the LICENSE file). CEA may also distribute it under specific
/// licensing conditions.
///
/// One translation unit per dimension keeps the template instantiation
/// cost of the grid parallel across compiler jobs and lets
/// TDLS_BENCH_DIMS build any subset. Generated at configure time from
/// dims/dim.cu.in; never installed, never part of the library.

#include <pure_lupp/variants_tdls.cuh>

/// \brief Static registration hook of this dimension.
[[maybe_unused]] static const bool tdls_bench_registered_d@TDLS_BENCH_DIM@ =
    (tdls_bench::register_dimension<@TDLS_BENCH_DIM@>(), true);
