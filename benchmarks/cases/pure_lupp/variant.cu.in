///
/// One translation unit per variant: the compile time of this file,
/// recorded by the compiler launcher, is the compile cost of this
/// variant alone, and the grid enumeration lives in one place
/// (generate_variants.cmake). Generated at configure time; never
/// installed, never tracked.

#include <pure_lupp/variants_tdls.cuh>

/// \brief Static registration hook of this variant.
[[maybe_unused]] static const bool tdls_bench_registered_@V_ID@ =
    (tdls_bench::register_variant<@V_SCALAR@, @V_N@, @V_TS@,
                                  tdls::TiledLUppSchedule::@V_SCHED@, @V_UNROLL@,
                                  tdls_bench::SolverKind::@V_KIND@,
                                  tdls_bench::Placement::@V_PLACEMENT@>(),
     true);
